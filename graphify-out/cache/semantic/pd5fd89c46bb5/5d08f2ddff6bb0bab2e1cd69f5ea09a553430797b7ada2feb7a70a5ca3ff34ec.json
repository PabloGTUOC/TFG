{"nodes": [{"id": "docs_admin_family_management_plan_md", "label": "Platform Admin & Subscriptions Plan", "file_type": "document", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_admin_family_management_plan_privacy_boundary", "label": "Admin Privacy Boundary (Landlord not Housemate)", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "users.platform_role is a global axis deliberately separate from family_members roles, so being an admin grants no rights inside any family; adminService maps every row through an explicit field allowlist and a CI leak-prevention test asserts only registry aggregates surface."}, {"id": "docs_admin_family_management_plan_entitlement_merge", "label": "Entitlement Merge \u2014 Most Generous Wins", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effective entitlement merges the default plan, a subscription in good standing, and unrevoked admin grants; store truth and admin truth never overwrite each other, and only past_due status triggers the 402 read-only gate \u2014 other lapsed statuses downgrade gracefully."}, {"id": "docs_admin_family_management_plan_family_heartbeat", "label": "Family Heartbeat Mechanism", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "families.last_active_at is touched only on successful (<400) family-scoped responses, throttled to one write per family per hour, so an unauthorized probe cannot keep a family looking alive; buckets active/dormant/inactive drive the admin registry without touching content tables."}, {"id": "docs_admin_family_management_plan_provider_swappability", "label": "Provider Swappability (RevenueCat Boundary)", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the Flutter purchase trigger and the webhook consumer are RevenueCat-aware; family_plans/billing_events/entitlements/admin area are provider-neutral via a 'provider' column, so a future Stripe web checkout becomes a third writer into the same tables."}, {"id": "docs_admin_family_management_plan_retention_flow", "label": "Inactivity Notice \u2192 Retention Sweep Process", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleanup of dormant families is a process, not a button: admin sends an audited inactivity notice, then scripts/retention-sweep.js deletes only families that stayed silent past a waiting period, dry-run by default, re-verifying inactivity before the DELETE."}, {"id": "docs_admin_family_management_plan_subscriber_attribute", "label": "family_id Subscriber Attribute (Purchase Attribution)", "file_type": "rationale", "source_file": "docs/admin-family-management-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting a family_id subscriber attribute just before the paywall replaced the planned purchase-intent-UUID endpoint, achieving the same store-purchase-to-family attribution with one moving part instead of three."}], "edges": [{"source": "docs_admin_family_management_plan_md", "target": "docs_backend_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/admin-family-management-plan.md", "source_locati