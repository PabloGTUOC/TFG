, "weight": 1.0}, {"source": "qa_frontend_layering", "target": "docs_flutter_frontend_ui_widgets", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "QA.md", "source_location": null, "weight": 1.0}, {"source": "qa_frontend_layering", "target": "docs_frontend_usetimeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "QA.md", "source_location": null, "weight": 1.0}, {"source": "qa_frontend_layering", "target": "docs_frontend_tasklibrary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "QA.md", "source_location": null, "weight": 1.0}], "hyperedges": []}