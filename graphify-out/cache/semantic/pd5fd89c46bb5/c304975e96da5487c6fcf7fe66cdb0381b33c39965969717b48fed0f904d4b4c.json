{"nodes": [{"id": "docs_design_md", "label": "CareCoins Design System", "file_type": "document", "source_file": "docs/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_family_operations_room", "label": "The Family Operations Room (Creative North Star)", "file_type": "rationale", "source_file": "docs/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CareCoins is styled as the shared dashboard a family runs on: structured enough to carry real information, warm enough to feel like home, with warmth earned through legibility and fair representation rather than decorative softness."}, {"id": "docs_design_one_job_rule", "label": "The One Job Rule (Semantic Color)", "file_type": "rationale", "source_file": "docs/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every color has exactly one semantic role and stays in it \u2014 blue for action, green for done, amber for household, red for danger \u2014 so a new color usually means a state variation of an existing token, not a new hue."}, {"id": "docs_design_flat_by_default_elevation", "label": "Flat-by-Default, Ambient-on-State Elevation", "file_type": "rationale", "source_file": "docs/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfaces stack through background color, not shadows; a shadow appears only when an element needs to communicate lift (FAB, modal, hover) \u2014 a static non-interactive element should never carry one."}, {"id": "docs_design_daily_timeline_component", "label": "Daily Timeline (Signature Component)", "file_type": "concept", "source_file": "docs/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source":