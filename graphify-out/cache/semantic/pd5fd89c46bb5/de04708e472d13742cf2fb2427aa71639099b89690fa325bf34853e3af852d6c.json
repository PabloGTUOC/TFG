 "rationale", "source_file": "docs/deployment-and-delivery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unmounted route falls through to a 404 handler while a mounted one answers 401, so probing /api/personal-time, /api/admin/families and /api/billing/webhook tells you what backend version is actually deployed without needing credentials."}], "edges": [{"source": "docs_deployment_and_delivery_md", "target": "docs_revenuecatsetup_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_and_delivery_md", "target": "docs_flutter_frontend_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_and_delivery_md", "target": "docs_backend_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_and_delivery_md", "target": "docs_database_schema_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_and_delivery_deploy_script", "target": "docs_deployment_and_delivery_reset_db", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_and_delivery_migration_activity_subclasses", "target": "docs_database_schema_activities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment-and-delivery.md", "source_location": null, "we